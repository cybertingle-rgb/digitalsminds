# Copy to .env (local) or set in your host's environment settings.
# Never commit real values.

# MySQL/MariaDB connection string (required for inquiries + /api/health).
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Public base URL of the site, no trailing slash (used for canonical URLs, sitemap, origin checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: public contact email (defaults to info@digitalsminds.com)
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional: POST each new inquiry as JSON to this URL (Zapier, Make, Slack workflow, CRM...)
INQUIRY_WEBHOOK_URL=""
