# Copy to .env (local) or set in your host's environment settings.
# Never commit real values.

# PostgreSQL connection string (required for inquiries + /api/health)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public base URL of the site, no trailing slash (used for canonical URLs, sitemap, origin checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional public contact channels; each is shown on the site only when set
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""   # digits only, international format, e.g. 923001234567

# Optional: POST each new inquiry as JSON to this URL (Zapier, Make, Slack workflow, CRM...)
INQUIRY_WEBHOOK_URL=""
