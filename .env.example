# Copy to .env (local) or set in your host's environment settings.
# Never commit real values.

# MySQL/MariaDB connection string (required for inquiries + /api/health).
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Public base URL of the site, no trailing slash (used for canonical URLs, sitemap, origin checks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# REQUIRED for accounts/login. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Also encrypts the SMTP password and Google secret saved in the admin panel:
# never change it once live (saved secrets would have to be re-entered).
BETTER_AUTH_SECRET=""

# One-time code for /setup (creating the info@digitalsminds.com Super Admin).
# At least 16 random characters. Remove it after setup is done.
ADMIN_SETUP_CODE=""

# Number of proxies in front of the app (for correct client IPs in rate limiting). Default 1.
TRUSTED_PROXY_HOPS=""

# Optional: public contact email (defaults to info@digitalsminds.com)
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Development only (never set these on Hostinger) ---
# Empty scratch database Prisma needs to generate new migrations correctly.
SHADOW_DATABASE_URL=""
# Disposable database for `npm run test:db` (its name must contain "test").
TEST_DATABASE_URL=""

# Optional: POST each new inquiry as JSON to this URL (Zapier, Make, Slack workflow, CRM...)
INQUIRY_WEBHOOK_URL=""
