// Digitals Minds database schema (MySQL / MariaDB).
// Every change here must ship with a migration: `npm run db:migrate -- --name <change>`.
// Conventions:
// - Bilingual CMS text: English column + optional `...Ur` column (falls back to English).
// - Courses and blog posts are written in ONE language (`language`); only their
//   catalogue/listing text is bilingual.
// - Learning history is never hard-deleted: courses are archived, enrollments revoked.
//   Relations that would destroy student records use `onDelete: Restrict`.
// - Auth tables (User, Session, Account, Verification, RateLimit) follow Better Auth's
//   schema; their ids are generated by Better Auth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Language {
  en
  ur
}

enum Role {
  SUPER_ADMIN
  CONTENT_MANAGER
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Accounts & authentication (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @db.VarChar(64)
  name          String   @db.VarChar(120)
  email         String   @unique @db.VarChar(254)
  emailVerified Boolean  @default(false)
  image         String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Digitals Minds profile fields
  role            Role       @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  /// Google account the student watches restricted Drive videos with.
  googleEmail     String?    @db.VarChar(254)
  phone           String?    @db.VarChar(40)
  city            String?    @db.VarChar(80)
  preferredLocale Language   @default(en)
  suspendedAt     DateTime?
  suspendedReason String?    @db.VarChar(500)

  sessions             Session[]
  accounts             Account[]
  enrollments          Enrollment[]            @relation("EnrollmentStudent")
  enrollmentDecisions  Enrollment[]            @relation("EnrollmentDecidedBy")
  lessonProgress       LessonProgress[]
  certificates         Certificate[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  teachingCourses      CourseInstructor[]
  coursesCreated       Course[]                @relation("CourseCreatedBy")
  announcements        Announcement[]
  posts                Post[]
  mediaUploads         MediaAsset[]
  inquiriesAssigned    Inquiry[]
  inquiryNotes         InquiryNote[]
  auditLogs            AuditLog[]
  settingsUpdated      SiteSetting[]
  payments             Payment[]               @relation("PaymentStudent")
  paymentDecisions     Payment[]               @relation("PaymentDecidedBy")
  liveClassesCreated   LiveClass[]
  batchesCoordinated   Batch[]                 @relation("BatchCoordinator")
  applications         EnrollmentApplication[] @relation("ApplicationStudent")
  applicationDecisions EnrollmentApplication[] @relation("ApplicationDecidedBy")
  enrollmentEvents     EnrollmentEvent[]
  onboardingChecks     OnboardingProgress[]
  documentsUploaded    StudentDocument[]

  @@index([role, status])
  @@index([createdAt])
}

model Session {
  id        String   @id @db.VarChar(64)
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  userId    String   @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @db.VarChar(64)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(64)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.VarChar(1000)
  /// Password hash (email/password accounts only). Never store or log plain passwords.
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

/// Durable rate-limit counters for login, sign-up and password reset.
model RateLimit {
  id          String @id @db.VarChar(64)
  key         String @unique @db.VarChar(255)
  count       Int
  /// Epoch milliseconds of the last request.
  lastRequest BigInt
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

enum MediaVisibility {
  /// Served to anyone (logos, thumbnails, blog images).
  PUBLIC
  /// Served only after an access check (course resources).
  PRIVATE
}

/// Uploaded file metadata. File bytes live in storage (never in the database).
model MediaAsset {
  id           String          @id @default(cuid())
  /// Path/key in the storage backend, e.g. "courses/abc/worksheet.pdf".
  storageKey   String          @unique @db.VarChar(500)
  originalName String          @db.VarChar(255)
  mimeType     String          @db.VarChar(127)
  sizeBytes    Int
  width        Int?
  height       Int?
  checksum     String?         @db.VarChar(128)
  altText      String?         @db.VarChar(255)
  altTextUr    String?         @db.VarChar(255)
  visibility   MediaVisibility @default(PUBLIC)
  uploadedById String?         @db.VarChar(64)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  courseThumbnails  Course[]
  courseResources   CourseResource[]
  postCovers        Post[]
  testimonialPhotos Testimonial[]
  caseStudyCovers   CaseStudy[]

  @@index([visibility, createdAt])
}

// ---------------------------------------------------------------------------
// Courses
// ---------------------------------------------------------------------------

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum EnrollmentMode {
  /// Student requests access; an admin approves (launch default).
  APPROVAL
  /// Student is enrolled immediately (future option).
  OPEN
  /// Only admins can enroll students (future option).
  INVITE_ONLY
}

enum AccessType {
  FREE
  /// Reserved for paid courses (not used at launch).
  PAID
}

enum VideoProvider {
  NONE
  GOOGLE_DRIVE
  YOUTUBE
  VIMEO
  BUNNY
}

model Course {
  id       String        @id @default(cuid())
  slug     String        @unique @db.VarChar(191)
  /// Language the course is taught in.
  language Language
  status   PublishStatus @default(DRAFT)

  // Catalogue listing (bilingual)
  title     String  @db.VarChar(200)
  titleUr   String? @db.VarChar(200)
  summary   String  @db.VarChar(500)
  summaryUr String? @db.VarChar(500)

  // Course detail (in the course language)
  description     String?     @db.Text
  /// Learning objectives, as a JSON array of strings.
  objectives      Json?
  prerequisites   String?     @db.Text
  level           CourseLevel @default(ALL_LEVELS)
  durationMinutes Int?
  thumbnailId     String?
  thumbnail       MediaAsset? @relation(fields: [thumbnailId], references: [id], onDelete: SetNull)

  // Access
  enrollmentMode     EnrollmentMode @default(APPROVAL)
  accessType         AccessType     @default(FREE)
  /// Price in minor units (e.g. paisa); only for PAID courses.
  priceAmount        Int?
  currency           String?        @db.Char(3)
  certificateEnabled Boolean        @default(true)

  /// Price review after the move to PKR base prices: the price as first entered,
  /// and how it was converted. Set only for prices that were not already PKR.
  originalPriceAmount Int?
  originalCurrency    String?   @db.Char(3)
  /// Units of PKR per 1 unit of the original currency used for the conversion.
  priceConversionRate Decimal?  @db.Decimal(24, 10)
  priceConvertedAt    DateTime?
  priceSource         String?   @db.VarChar(200)
  /// Price whose currency is not PKR and still needs a Super Admin to confirm it.
  priceNeedsReview    Boolean   @default(false)

  // Catalogue category
  categoryId String?
  category   ProgramCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Training program details (shown on the public page)
  format       TrainingFormat @default(ONLINE_LIVE)
  /// e.g. "8 weeks, 3 live classes a week".
  durationText String?        @db.VarChar(160)

  // Catalogue placement
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
  /// Related service division slug (src/content/services.ts), optional.
  serviceSlug String? @db.VarChar(64)

  // SEO overrides
  seoTitle       String? @db.VarChar(200)
  seoDescription String? @db.VarChar(320)

  publishedAt DateTime?
  createdById String?   @db.VarChar(64)
  createdBy   User?     @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instructors     CourseInstructor[]
  modules         CourseModule[]
  resources       CourseResource[]
  enrollments     Enrollment[]
  certificates    Certificate[]
  announcements   Announcement[]
  supportTickets  SupportTicket[]
  payments        Payment[]
  liveClasses     LiveClass[]
  batches         Batch[]
  applications    EnrollmentApplication[]
  onboardingItems OnboardingItem[]
  documents       StudentDocument[]

  @@index([status, featured, sortOrder])
  @@index([language, status])
  @@index([categoryId])
}

/// Instructors can manage only the courses they are assigned to.
model CourseInstructor {
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String   @db.VarChar(64)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([courseId, userId])
  @@index([userId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id              String        @id @default(cuid())
  moduleId        String
  module          CourseModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String        @db.VarChar(200)
  /// Lesson notes/text (rich text stored as HTML or Markdown, decided in Phase 7).
  content         String?       @db.Text
  videoProvider   VideoProvider @default(NONE)
  /// Link as pasted by the admin (e.g. a Google Drive share link).
  videoUrl        String?       @db.VarChar(1000)
  durationMinutes Int?
  position        Int
  /// Free preview lessons are visible on the public course page.
  isPreview       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  resources CourseResource[]
  progress  LessonProgress[]

  @@index([moduleId, position])
}

enum ResourceKind {
  FILE
  LINK
}

/// Downloadable file or external link attached to a course or a lesson.
model CourseResource {
  id           String       @id @default(cuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String       @db.VarChar(200)
  kind         ResourceKind
  mediaAssetId String?
  /// Files in use cannot be deleted from the media library.
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  url          String?      @db.VarChar(1000)
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([courseId, position])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// Enrollment, progress & certificates
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
}

model Enrollment {
  id           String           @id @default(cuid())
  userId       String           @db.VarChar(64)
  user         User             @relation("EnrollmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  /// Courses with enrollments cannot be deleted (archive them instead).
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status       EnrollmentStatus @default(REQUESTED)
  /// Message from the student with the request (optional).
  requestNote  String?          @db.VarChar(1000)
  requestedAt  DateTime         @default(now())
  decidedAt    DateTime?
  decidedById  String?          @db.VarChar(64)
  decidedBy    User?            @relation("EnrollmentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Admin's reason for rejection/revocation (shown to the student if set).
  decisionNote String?          @db.VarChar(1000)
  completedAt  DateTime?
  /// Batch the student is placed in (null for enrollments made before batches existed).
  batchId      String?
  batch        Batch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  /// Administrative stage (null for enrollments made before stages existed).
  stage        EnrollmentStage?
  stageAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  application EnrollmentApplication?
  events      EnrollmentEvent[]
  onboarding  OnboardingProgress[]

  attendance Attendance[]

  @@unique([userId, courseId])
  @@index([batchId, stage])
  @@index([courseId, status])
  @@index([status, requestedAt])
}

model LessonProgress {
  userId       String    @db.VarChar(64)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  /// Drives "continue learning".
  lastViewedAt DateTime  @default(now())

  @@id([userId, lessonId])
  @@index([lessonId])
  @@index([userId, lastViewedAt])
}

model Certificate {
  id            String    @id @default(cuid())
  /// Public verification code shown on the certificate.
  code          String    @unique @db.VarChar(32)
  userId        String    @db.VarChar(64)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// Name and course title as printed, kept even if they change later.
  recipientName String    @db.VarChar(120)
  courseTitle   String    @db.VarChar(200)
  issuedAt      DateTime  @default(now())
  revokedAt     DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// Communication: announcements, notifications, support
// ---------------------------------------------------------------------------

model Announcement {
  id          String    @id @default(cuid())
  /// Null = site-wide announcement for all students.
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Set = only this batch's students (courseId is then the batch's program).
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(200)
  body        String    @db.Text
  authorId    String?   @db.VarChar(64)
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId, publishedAt])
  @@index([batchId, publishedAt])
}

enum NotificationType {
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  ENROLLMENT_REVOKED
  ANNOUNCEMENT
  ENROLLMENT_UPDATE
  SCHEDULE
  SUPPORT_REPLY
  CERTIFICATE_ISSUED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.VarChar(64)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.VarChar(1000)
  /// In-app path to open, e.g. "/learn/course-slug".
  link      String?          @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

enum TicketStatus {
  OPEN
  AWAITING_STUDENT
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String       @db.VarChar(64)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subject   String       @db.VarChar(200)
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?

  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?       @db.VarChar(64)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String        @db.Text
  /// Staff-only note, never shown to the student.
  internal  Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Website content (CMS)
// ---------------------------------------------------------------------------

model Post {
  id             String        @id @default(cuid())
  slug           String        @unique @db.VarChar(191)
  /// Language the post is written in.
  language       Language      @default(en)
  status         PublishStatus @default(DRAFT)
  title          String        @db.VarChar(200)
  excerpt        String        @db.VarChar(500)
  body           String        @db.LongText
  /// Tags as a JSON array of strings.
  tags           Json?
  coverImageId   String?
  coverImage     MediaAsset?   @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  authorId       String?       @db.VarChar(64)
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Display name if different from the author account (e.g. "Digitals Minds Team").
  authorName     String?       @db.VarChar(120)
  seoTitle       String?       @db.VarChar(200)
  seoDescription String?       @db.VarChar(320)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Faq {
  id         String   @id @default(cuid())
  question   String   @db.VarChar(300)
  questionUr String?  @db.VarChar(300)
  answer     String   @db.Text
  answerUr   String?  @db.Text
  /// Optional grouping, e.g. "courses", "services".
  category   String?  @db.VarChar(64)
  position   Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, category, position])
}

/// Only real testimonials, published with the person's permission.
model Testimonial {
  id               String      @id @default(cuid())
  name             String      @db.VarChar(120)
  roleTitle        String?     @db.VarChar(160)
  company          String?     @db.VarChar(160)
  quote            String      @db.Text
  quoteUr          String?     @db.Text
  photoId          String?
  photo            MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /// Must be true before publishing: the person agreed to be quoted.
  consentConfirmed Boolean     @default(false)
  published        Boolean     @default(false)
  featured         Boolean     @default(false)
  position         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([published, featured, position])
}

/// Only verified client work, published with the client's permission.
model CaseStudy {
  id               String      @id @default(cuid())
  slug             String      @unique @db.VarChar(191)
  title            String      @db.VarChar(200)
  titleUr          String?     @db.VarChar(200)
  client           String?     @db.VarChar(160)
  summary          String      @db.VarChar(500)
  summaryUr        String?     @db.VarChar(500)
  body             String      @db.LongText
  bodyUr           String?     @db.LongText
  serviceSlug      String?     @db.VarChar(64)
  coverImageId     String?
  coverImage       MediaAsset? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  consentConfirmed Boolean     @default(false)
  published        Boolean     @default(false)
  position         Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([published, position])
}

/// Editable site-wide settings and content blocks, keyed by name
/// (e.g. "home.hero", "contact", "social", "seo:/about").
model SiteSetting {
  key         String   @id @db.VarChar(191)
  value       Json
  updatedById String?  @db.VarChar(64)
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Leads & newsletter
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

/// Leads submitted through the website's inquiry/contact forms.
model Inquiry {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(254)
  phone     String?       @db.VarChar(40)
  company   String?       @db.VarChar(160)
  /// Service slug from src/content/services.ts, or "general".
  service   String        @db.VarChar(64)
  message   String        @db.Text
  /// Page the form was submitted from, for lead attribution.
  source    String?       @db.VarChar(200)
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Added in Phase 2 (all optional, existing rows unaffected)
  locale       Language?
  utmSource    String?   @db.VarChar(100)
  utmMedium    String?   @db.VarChar(100)
  utmCampaign  String?   @db.VarChar(150)
  followUpAt   DateTime?
  assignedToId String?   @db.VarChar(64)
  assignedTo   User?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  notes InquiryNote[]

  @@index([status, createdAt])
  @@index([email])
  @@index([followUpAt])
  @@index([assignedToId])
}

model InquiryNote {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String?  @db.VarChar(64)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique @db.VarChar(254)
  locale           Language         @default(en)
  status           SubscriberStatus @default(SUBSCRIBED)
  /// When and where consent was given.
  consentAt        DateTime         @default(now())
  source           String?          @db.VarChar(200)
  /// Secret for one-click unsubscribe links.
  unsubscribeToken String           @unique @db.VarChar(64)
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

/// Append-only record of sensitive admin actions (who did what, to which record).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.VarChar(64)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// e.g. "enrollment.approve", "user.suspend", "export.students".
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  /// Extra context (before/after values). Never put passwords or tokens here.
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Payments for paid courses (manual: bank transfer, JazzCash, EasyPaisa)
// ---------------------------------------------------------------------------

enum PaymentMethod {
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  /// Submitted by the student; waiting for a Super Admin to check it.
  PENDING
  /// Money received; course access opened.
  CONFIRMED
  /// Not received or details wrong; the student can submit again.
  REJECTED
}

/// A student's payment for a paid course, confirmed by a Super Admin.
model Payment {
  id             String                 @id @default(cuid())
  /// The student; null while the payment belongs to an application that has no account yet.
  userId         String?                @db.VarChar(64)
  user           User?                  @relation("PaymentStudent", fields: [userId], references: [id], onDelete: Cascade)
  /// Enrollment application this payment is for (applications made after batches existed).
  applicationId  String?
  application    EnrollmentApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  /// Amount the Super Admin saw arrive in the account, in paisa.
  amountReceived Int?
  /// "METHOD:REFERENCE" of a verified payment: the same transaction can't be verified twice.
  verifiedKey    String?                @unique @db.VarChar(120)
  courseId       String
  /// Courses with payments cannot be deleted (archive them instead).
  course         Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// Fee in paisa (PKR minor units) when the student paid; the course price may change later.
  amount         Int
  currency       String                 @default("PKR") @db.Char(3)
  method         PaymentMethod
  /// Transaction ID / reference the student copied from their bank or wallet.
  reference      String                 @db.VarChar(100)
  payerName      String?                @db.VarChar(120)
  /// What a payer abroad says they sent, in minor units of sentCurrency (information only; amountReceived is what counts).
  sentAmount     Int?
  sentCurrency   String?                @db.Char(3)
  paidOn         DateTime?              @db.Date
  note           String?                @db.VarChar(1000)
  /// Receipt screenshot or PDF, stored privately (never in the Media library).
  receiptKey     String?                @db.VarChar(500)
  receiptMime    String?                @db.VarChar(127)
  receiptSize    Int?
  receiptName    String?                @db.VarChar(255)
  status         PaymentStatus          @default(PENDING)
  decidedAt      DateTime?
  decidedById    String?                @db.VarChar(64)
  decidedBy      User?                  @relation("PaymentDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Reason shown to the student when a payment is rejected.
  decisionNote   String?                @db.VarChar(1000)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([userId, courseId])
  @@index([courseId])
  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Live classes (Zoom / Google Meet sessions for a course's students)
// ---------------------------------------------------------------------------

enum LiveClassStatus {
  SCHEDULED
  CANCELLED
}

model LiveClass {
  id                 String          @id @default(cuid())
  courseId           String
  course             Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title              String          @db.VarChar(200)
  description        String?         @db.Text
  startsAt           DateTime
  durationMinutes    Int
  /// Zoom, Google Meet or Teams link; shown only to the course's approved students and staff.
  meetingUrl         String?         @db.VarChar(500)
  /// Class, holiday or other event in a batch's schedule.
  kind               SessionKind     @default(CLASS)
  /// Set = only this batch (courseId is then the batch's program).
  batchId            String?
  batch              Batch?          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status             LiveClassStatus @default(SCHEDULED)
  createdById        String?         @db.VarChar(64)
  createdBy          User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Set when the 1-day / 1-hour reminders were sent, so each goes out once.
  reminderDaySentAt  DateTime?
  reminderHourSentAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  attendance Attendance[]

  @@index([courseId, startsAt])
  @@index([status, startsAt])
  @@index([batchId, startsAt])
}

enum SessionKind {
  CLASS
  HOLIDAY
  EVENT
}

// ---------------------------------------------------------------------------
// Enrollment platform: programs run in batches; visitors apply, pay, and are
// given a student account only after a Super Admin verifies the payment.
// ---------------------------------------------------------------------------

enum TrainingFormat {
  ONLINE_LIVE
  IN_PERSON
  HYBRID
}

enum BatchStatus {
  /// Being prepared; not shown publicly.
  DRAFT
  /// Shown publicly and accepting applications (until full or past the deadline).
  OPEN
  /// Shown, not accepting applications.
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// One intake of a program, with its own dates, schedule and seats.
model Batch {
  id                  String      @id @default(cuid())
  courseId            String
  course              Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name                String      @db.VarChar(120)
  /// Short unique code, e.g. "EBAY-07".
  code                String      @unique @db.VarChar(32)
  status              BatchStatus @default(DRAFT)
  startDate           DateTime    @db.Date
  endDate             DateTime?   @db.Date
  /// Public schedule summary, e.g. "Mon, Wed, Fri · 8:00-10:00 pm (PKT)".
  scheduleText        String      @db.VarChar(300)
  /// Seats; counted when a payment is verified.
  capacity            Int
  applicationDeadline DateTime?   @db.Date
  /// Default Zoom / Google Meet link; shown only to this batch's active students.
  meetingUrl          String?     @db.VarChar(500)
  /// How to join and attend; shown only to this batch's students.
  joiningInfo         String?     @db.Text
  /// Staff-only notes.
  internalNotes       String?     @db.Text
  coordinatorId       String?     @db.VarChar(64)
  coordinator         User?       @relation("BatchCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  /// IANA time zone the batch's class times are set and shown in, e.g. "Asia/Karachi".
  timeZone            String      @default("Asia/Karachi") @db.VarChar(64)
  /// Staff record attendance for this batch's classes (off unless switched on).
  attendanceEnabled   Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  enrollments     Enrollment[]
  applications    EnrollmentApplication[]
  sessions        LiveClass[]
  announcements   Announcement[]
  onboardingItems OnboardingItem[]
  documents       StudentDocument[]

  @@index([courseId, status, startDate])
  @@index([status, startDate])
}

/// Administrative stages of a student's journey. Applications use the first
/// five; enrollments continue from ENROLLMENT_CONFIRMED.
enum EnrollmentStage {
  APPLICATION_RECEIVED
  PAYMENT_PENDING
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  ENROLLMENT_CONFIRMED
  ONBOARDING
  ACTIVE
  COMPLETED
  WITHDRAWN
  REJECTED
  CANCELLED
}

/// A visitor's application for a batch, before (and leading to) a student account.
model EnrollmentApplication {
  id               String          @id @default(cuid())
  /// Human-friendly reference shown to the applicant, e.g. "DM-7KQ4-XZ2M".
  reference        String          @unique @db.VarChar(20)
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId          String
  batch            Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  name             String          @db.VarChar(120)
  /// Lower-case.
  email            String          @db.VarChar(254)
  phone            String          @db.VarChar(40)
  city             String          @db.VarChar(80)
  /// "12345-1234567-1". Visible to Super Admins only.
  cnic             String          @db.VarChar(15)
  /// CV stored privately (never in the Media library). Visible to Super Admins only.
  cvKey            String?         @db.VarChar(500)
  cvMime           String?         @db.VarChar(127)
  cvSize           Int?
  cvName           String?         @db.VarChar(255)
  message          String?         @db.VarChar(1000)
  /// Fee in paisa when the applicant applied (the program fee may change later).
  feeAmount        Int
  currency         String          @default("PKR") @db.Char(3)
  /// Converted estimate the applicant was shown when applying (display only; the PKR fee is what is owed).
  displayCurrency  String?         @db.Char(3)
  /// In minor units of displayCurrency.
  displayAmount    Int?
  /// Units of displayCurrency per 1 PKR.
  displayRate      Decimal?        @db.Decimal(24, 12)
  displayRateAt    DateTime?
  displayProvider  String?         @db.VarChar(100)
  stage            EnrollmentStage @default(APPLICATION_RECEIVED)
  /// SHA-256 of the private status-link token (the token itself is only emailed).
  tokenHash        String          @unique @db.Char(64)
  emailConfirmedAt DateTime?
  termsAcceptedAt  DateTime
  /// "email|batchId" while the application is open; null once closed. Stops duplicates.
  openKey          String?         @unique @db.VarChar(300)
  /// Student account created (or reused) when the payment was verified.
  userId           String?         @db.VarChar(64)
  user             User?           @relation("ApplicationStudent", fields: [userId], references: [id], onDelete: SetNull)
  enrollmentId     String?         @unique
  enrollment       Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decidedById      String?         @db.VarChar(64)
  decidedBy        User?           @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Reason shown to the applicant when rejected or cancelled.
  decisionNote     String?         @db.VarChar(1000)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  payments Payment[]
  events   EnrollmentEvent[]

  @@index([stage, createdAt])
  @@index([batchId, stage])
  @@index([email])
}

/// Timeline of stage changes for an application and the enrollment that follows it.
model EnrollmentEvent {
  id            String                 @id @default(cuid())
  applicationId String?
  application   EnrollmentApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enrollmentId  String?
  enrollment    Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stage         EnrollmentStage
  /// Shown to the student (e.g. why a payment was rejected).
  note          String?                @db.VarChar(1000)
  actorId       String?                @db.VarChar(64)
  actor         User?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime               @default(now())

  @@index([applicationId, createdAt])
  @@index([enrollmentId, createdAt])
}

/// Onboarding checklist item for all students, one program, or one batch.
model OnboardingItem {
  id               String    @id @default(cuid())
  courseId         String?
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchId          String?
  batch            Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  required         Boolean   @default(true)
  /// True = the student ticks it; false = staff confirm it (e.g. "Documents checked").
  studentCompletes Boolean   @default(true)
  position         Int       @default(0)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  progress OnboardingProgress[]

  @@index([courseId, position])
  @@index([batchId, position])
}

model OnboardingProgress {
  enrollmentId  String
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  itemId        String
  item          OnboardingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  completedAt   DateTime       @default(now())
  completedById String?        @db.VarChar(64)
  completedBy   User?          @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@id([enrollmentId, itemId])
  @@index([itemId])
}

/// Forms, policies and onboarding files for all students, one program, or one batch. Stored privately.
model StudentDocument {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(200)
  description  String?  @db.VarChar(500)
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  storageKey   String   @unique @db.VarChar(500)
  fileName     String   @db.VarChar(255)
  mimeType     String   @db.VarChar(127)
  sizeBytes    Int
  published    Boolean  @default(true)
  uploadedById String?  @db.VarChar(64)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId, published])
  @@index([batchId, published])
}

// ---------------------------------------------------------------------------
// Catalogue: program categories and professional services
// ---------------------------------------------------------------------------

/// A group of training programs and services, e.g. "E-commerce Marketplace Training".
model ProgramCategory {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(100)
  title     String   @db.VarChar(160)
  titleUr   String?  @db.VarChar(160)
  summary   String?  @db.VarChar(500)
  summaryUr String?  @db.VarChar(500)
  /// Important notice shown on the category's program and service pages (eligibility, no guarantees).
  notice    String?  @db.Text
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses  Course[]
  services Service[]

  @@index([active, sortOrder])
}

/// A professional service visitors can inquire about (no account needed).
model Service {
  id             String           @id @default(cuid())
  slug           String           @unique @db.VarChar(100)
  status         PublishStatus    @default(DRAFT)
  title          String           @db.VarChar(160)
  shortTitle     String?          @db.VarChar(80)
  summary        String           @db.VarChar(500)
  description    String?          @db.Text
  /// What is included, as a JSON array of strings.
  offerings      Json?
  /// Who it suits, as a JSON array of strings.
  idealFor       Json?
  /// Scope and limits shown on the page (e.g. "approval is the marketplace's decision").
  notice         String?          @db.Text
  categoryId     String?
  category       ProgramCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder      Int              @default(0)
  seoTitle       String?          @db.VarChar(200)
  seoDescription String?          @db.VarChar(320)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Currency conversion for price display (PKR is the base currency)
// ---------------------------------------------------------------------------

/// Last known good exchange rate for one currency, from the configured provider.
model CurrencyRate {
  /// ISO 4217 code, e.g. "USD".
  currency        String   @id @db.Char(3)
  /// Units of this currency per 1 PKR.
  perPkr          Decimal  @db.Decimal(24, 12)
  provider        String   @db.VarChar(100)
  /// When the provider says the rate was last updated.
  sourceUpdatedAt DateTime
  /// When this site fetched it.
  fetchedAt       DateTime
}

// ---------------------------------------------------------------------------
// Attendance (only for batches where it is switched on)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

model Attendance {
  id           String           @id @default(cuid())
  liveClassId  String
  liveClass    LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  note         String?          @db.VarChar(300)
  markedById   String?          @db.VarChar(64)
  markedAt     DateTime         @default(now())

  @@unique([liveClassId, enrollmentId])
  @@index([enrollmentId])
}
